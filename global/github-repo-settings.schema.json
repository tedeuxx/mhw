{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHub repository settings and delivery rulesets (Issue #591, ADR-0045)",
  "description": "The shape of global/github-repo-settings.json. Each ruleset is a GitHub ruleset API body (POST repos/OWNER/REPO/rulesets). Only the keywords the project-policy evaluator implements are used, so test/review-status/rulesets.test.js applies this schema with it.",
  "type": "object",
  "required": [
    "description",
    "settings",
    "rulesets"
  ],
  "additionalProperties": false,
  "properties": {
    "description": {
      "type": "string",
      "minLength": 1
    },
    "settings": {
      "type": "object",
      "required": [
        "allow_merge_commit",
        "allow_squash_merge",
        "allow_rebase_merge"
      ],
      "additionalProperties": false,
      "properties": {
        "allow_merge_commit": {
          "const": true
        },
        "allow_squash_merge": {
          "const": false
        },
        "allow_rebase_merge": {
          "const": false
        }
      }
    },
    "rulesets": {
      "$comment": "Exactly one ruleset per delivery branch: rc/next, then main.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "conditions": {
                "type": "object",
                "properties": {
                  "ref_name": {
                    "type": "object",
                    "properties": {
                      "include": {
                        "const": [
                          "refs/heads/rc/next"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "conditions": {
                "type": "object",
                "properties": {
                  "ref_name": {
                    "type": "object",
                    "properties": {
                      "include": {
                        "const": [
                          "refs/heads/main"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "items": {
        "type": "object",
        "required": [
          "name",
          "target",
          "enforcement",
          "bypass_actors",
          "conditions",
          "rules"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "const": "branch"
          },
          "enforcement": {
            "const": "active"
          },
          "bypass_actors": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "type": "object",
              "required": [
                "actor_id",
                "actor_type",
                "bypass_mode"
              ],
              "additionalProperties": false,
              "properties": {
                "actor_id": {
                  "type": "integer",
                  "minimum": 1
                },
                "actor_type": {
                  "enum": [
                    "RepositoryRole"
                  ]
                },
                "bypass_mode": {
                  "enum": [
                    "always"
                  ]
                }
              }
            }
          },
          "conditions": {
            "type": "object",
            "required": [
              "ref_name"
            ],
            "additionalProperties": false,
            "properties": {
              "ref_name": {
                "type": "object",
                "required": [
                  "include",
                  "exclude"
                ],
                "additionalProperties": false,
                "properties": {
                  "include": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "enum": [
                        "refs/heads/rc/next",
                        "refs/heads/main"
                      ]
                    }
                  },
                  "exclude": {
                    "type": "array",
                    "maxItems": 0
                  }
                }
              }
            }
          },
          "rules": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "uniqueItems": true,
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "deletion"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "non_fast_forward"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "pull_request"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "required_status_checks"
                    }
                  }
                }
              }
            ],
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "enum": [
                    "deletion",
                    "non_fast_forward",
                    "pull_request",
                    "required_status_checks"
                  ]
                },
                "parameters": {
                  "type": "object"
                }
              },
              "allOf": [
                {
                  "if": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "pull_request"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "parameters"
                    ],
                    "properties": {
                      "parameters": {
                        "type": "object",
                        "required": [
                          "required_approving_review_count",
                          "dismiss_stale_reviews_on_push",
                          "require_code_owner_review",
                          "require_last_push_approval",
                          "required_review_thread_resolution",
                          "allowed_merge_methods"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "required_approving_review_count": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "dismiss_stale_reviews_on_push": {
                            "type": "boolean"
                          },
                          "require_code_owner_review": {
                            "type": "boolean"
                          },
                          "require_last_push_approval": {
                            "type": "boolean"
                          },
                          "required_review_thread_resolution": {
                            "type": "boolean"
                          },
                          "allowed_merge_methods": {
                            "const": [
                              "merge"
                            ]
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "if": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "required_status_checks"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "parameters"
                    ],
                    "properties": {
                      "parameters": {
                        "type": "object",
                        "required": [
                          "strict_required_status_checks_policy",
                          "do_not_enforce_on_create",
                          "required_status_checks"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "strict_required_status_checks_policy": {
                            "const": true
                          },
                          "do_not_enforce_on_create": {
                            "type": "boolean"
                          },
                          "required_status_checks": {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "allOf": [
                              {
                                "contains": {
                                  "type": "object",
                                  "properties": {
                                    "context": {
                                      "const": "delivery-ci"
                                    }
                                  }
                                }
                              },
                              {
                                "contains": {
                                  "type": "object",
                                  "properties": {
                                    "context": {
                                      "const": "review/route"
                                    }
                                  }
                                }
                              },
                              {
                                "contains": {
                                  "type": "object",
                                  "properties": {
                                    "context": {
                                      "const": "review/quality-assurance"
                                    }
                                  }
                                }
                              }
                            ],
                            "items": {
                              "type": "object",
                              "required": [
                                "context"
                              ],
                              "additionalProperties": false,
                              "properties": {
                                "context": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "integration_id": {
                                  "type": "integer",
                                  "minimum": 1
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        "allOf": [
          {
            "$comment": "rc/next: no bypass actor at all, and the lens is required there.",
            "if": {
              "type": "object",
              "properties": {
                "conditions": {
                  "type": "object",
                  "properties": {
                    "ref_name": {
                      "type": "object",
                      "properties": {
                        "include": {
                          "const": [
                            "refs/heads/rc/next"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "bypass_actors": {
                  "type": "array",
                  "maxItems": 0
                },
                "rules": {
                  "type": "array",
                  "contains": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "required_status_checks"
                      },
                      "parameters": {
                        "type": "object",
                        "properties": {
                          "required_status_checks": {
                            "type": "array",
                            "contains": {
                              "type": "object",
                              "properties": {
                                "context": {
                                  "const": "review/agents-lead"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
