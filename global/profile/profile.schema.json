{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable workstation profile, version 1",
  "description": "Declarative preferences only. No credentials, accounts, endpoints, arbitrary prompts or native permission grants. profile.py validates the subset of JSON Schema used here without dependencies.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "conversation", "interaction", "session_start", "surfaces"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "publication_language", "decision_tone"],
      "properties": {
        "language": { "type": "string", "enum": ["en", "pt-BR"] },
        "publication_language": { "type": "string", "enum": ["en", "pt-BR"] },
        "decision_tone": { "type": "string", "enum": ["concise", "executive-concise", "conversational", "didactic"] },
        "cadence": { "type": "string", "enum": ["paced"] },
        "context_discipline": { "type": "string", "enum": ["minimum-sufficient"] }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_question_chars", "command_preference"],
      "properties": {
        "max_question_chars": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "command_preference": { "type": "string", "enum": ["slash", "natural-language"] },
        "decision_options": { "type": "integer", "enum": [3] }
      }
    },
    "session_start": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority"],
      "properties": {
        "priority": { "type": "string", "enum": ["unselected", "balanced", "quality", "speed"] }
      }
    },
    "desktop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notifications"],
      "properties": {
        "notifications": { "type": "string", "enum": ["essential"] }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["claude-code", "codex", "kiro-cli", "claude-desktop"] }
    }
  }
}
