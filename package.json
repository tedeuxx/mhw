{
  "name": "mhw",
  "version": "4.1.0",
  "private": true,
  "description": "multi-harness managed workstation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tedeuxx/personal-multi-harness-workstation-configuration.git"
  },
  "bin": {
    "mhw": "bin/mhw.js",
    "workstation": "bin/workstation.js"
  },
  "scripts": {
    "postinstall": "node bin/postinstall.js"
  },
  "files": [
    "mhw",
    "workstation",
    ".bumpversion.toml",
    ".workstation-archive",
    "bin/mhw.js",
    "bin/postinstall.js",
    "bin/workstation.js",
    "global/",
    "!global/**/*_test.py",
    "!global/**/*.test.sh",
    "!global/**/*.test.ps1",
    "!global/**/*.test.stub",
    "!global/keychain_test_guard.py",
    "method/",
    "overlay/",
    "!overlay/mcp-servers.json",
    "!**/*.local.json",
    "!**/__pycache__/"
  ],
  "engines": {
    "node": ">=18"
  }
}
