{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tadeumendonca.dev/schemas/worklog-event-v1.json",
  "title": "Worklog event v1",
  "$defs": {
    "publicString": {"type": "string", "pattern": "\\S", "not": {"pattern": "(?:^|[\\s`])(?:/Users/|/private/tmp/|file://|\\.brand/)"}},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["harness", "runtime_version", "plugin", "persona", "provenance"],
      "properties": {
        "harness": {"type": "string", "minLength": 1, "$comment": "Free text. Reports compare it case-folded with every non-ASCII-alphanumeric character dropped, so Kiro, kiro and ki-ro are one harness; a value that folds to nothing counts as unknown (#515)."}, "runtime_version": {"type": "string", "minLength": 1},
        "persona": {"type": "string", "minLength": 1}, "provenance": {"type": "string", "enum": ["observed", "declared", "unknown"]},
        "plugin": {"type": "object", "additionalProperties": false, "required": ["version", "source_revision"],
          "properties": {"version": {"type": "string", "minLength": 1}, "source_revision": {"type": "string", "minLength": 1}}}
      }
    },
    "revision": {"type": "object", "additionalProperties": false, "required": ["repository", "branch", "commit"],
      "properties": {"repository": {"type": "string", "pattern": "^[^/\\s]+/[^/#\\s]+$"}, "branch": {"type": "string", "minLength": 1},
        "commit": {"anyOf": [{"type": "null"}, {"const": "unknown"}, {"type": "string", "pattern": "^[0-9a-f]{7,40}$"}]}}},
    "handoff": {"type": "object", "additionalProperties": false, "required": ["state", "to"],
      "properties": {"state": {"type": "string", "minLength": 1}, "to": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]}}},
    "estimate": {"type": "object", "additionalProperties": false, "required": ["points", "provenance", "commitment_points"],
      "properties": {"points": {"type": "integer", "minimum": 1}, "provenance": {"type": "string", "minLength": 1}, "commitment_points": {"type": "integer", "minimum": 1}}}
  },
  "type": "object",
  "required": ["schema_version", "event_id", "issue", "timestamp", "event_type", "stage", "run_id", "attempt_id", "attribution", "revision", "evidence", "handoff"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1}, "event_id": {"type": "string", "minLength": 1},
    "issue": {"type": "string", "pattern": "^[^/\\s]+/[^#\\s]+#[1-9][0-9]*$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "event_type": {"type": "string", "enum": ["implementation_start", "checkpoint", "handoff", "outcome", "correction"]},
    "stage": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}, "attempt_id": {"type": "string", "minLength": 1},
    "predecessor_event_id": {"type": ["string", "null"], "minLength": 1}, "resume_of_event_id": {"type": ["string", "null"], "minLength": 1},
    "attribution": {"$ref": "#/$defs/identity"}, "revision": {"$ref": "#/$defs/revision"},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/publicString"}}, "handoff": {"$ref": "#/$defs/handoff"},
    "frozen_estimate": {"$ref": "#/$defs/estimate"},
    "next_act": {"allOf": [{"$ref": "#/$defs/publicString"}, {"maxLength": 280, "not": {"pattern": "[\\r\\n]"}},
      {"not": {"pattern": "/[tT][mM][pP]/|~/|/[vV][aA][rR]/[fF][oO][lL][dD][eE][rR][sS]/|/[hH][oO][mM][eE]/|/[uU][sS][eE][rR][sS]/|/[pP][rR][iI][vV][aA][tT][eE]/|[fF][iI][lL][eE]://|\\.[bB][rR][aA][nN][dD](?![A-Za-z0-9_-])|\\b[A-Za-z]:\\\\"}}],
      "description": "Continuity (#514): the one next act a resuming session performs. Checkpoint and handoff only; required on a handoff when the event is prepared. The second pattern is the strict privacy filter, spelled case-insensitively without flags."},
    "outcome": {"type": "string", "enum": ["accepted", "reopened", "cancelled", "superseded", "no_longer_relevant"]},
    "completion_sprint": {"type": "string", "minLength": 1}, "acceptance_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/publicString"}},
    "supersedes_event_id": {"type": "string", "minLength": 1},
    "corrected_event": {"allOf": [{"$ref": "#"}, {"properties": {"event_type": {"type": "string", "enum": ["implementation_start", "checkpoint", "handoff", "outcome"]}}}]}
  },
  "allOf": [
    {"if": {"required": ["next_act"]}, "then": {"properties": {"event_type": {"enum": ["checkpoint", "handoff"]}}}},
    {"if": {"properties": {"event_type": {"const": "implementation_start"}}}, "then": {"required": ["frozen_estimate"]}, "else": {"not": {"required": ["frozen_estimate"]}}},
    {"if": {"properties": {"event_type": {"const": "outcome"}}}, "then": {"required": ["outcome"]},
      "else": {"not": {"anyOf": [{"required": ["outcome"]}, {"required": ["completion_sprint"]}, {"required": ["acceptance_evidence"]}]}}},
    {"if": {"properties": {"outcome": {"const": "accepted"}}, "required": ["outcome"]}, "then": {"required": ["completion_sprint", "acceptance_evidence"]},
      "else": {"not": {"anyOf": [{"required": ["completion_sprint"]}, {"required": ["acceptance_evidence"]}]}}},
    {"if": {"properties": {"event_type": {"const": "correction"}}}, "then": {"required": ["supersedes_event_id", "corrected_event"]},
      "else": {"not": {"anyOf": [{"required": ["supersedes_event_id"]}, {"required": ["corrected_event"]}]}}}
  ]
}
