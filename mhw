#!/bin/sh
# mhw, the one entry point of the multi-harness managed workstation (Issue #67), macOS and Linux:
#   ./mhw install | install --admin | status [--verbose] | check | scan | update [vX.Y.Z] | uninstall
# An npm install puts the same command on PATH as mhw (Issue #68, ADR-0034). The logic is
# global/workstation.py; global/install.sh and global/install-managed.sh stay the internals.
# Windows keeps global/install.ps1. ./workstation is the deprecated alias of this file.
dir=$(cd "$(dirname "$0")" && pwd)
command -v python3 >/dev/null 2>&1 || { echo "mhw: python3 (3.9 or later) is required" >&2; exit 2; }
exec python3 -B "$dir/global/workstation.py" "$@"
