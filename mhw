#!/usr/bin/env node
":" //; command -v node >/dev/null 2>&1 || { echo "mhw: node (26 or later) is required" >&2; exit 2; }; dir=$(cd "$(dirname "$0")" && pwd); exec node "$dir/bin/mhw.js" "$@"
// mhw, the one entry point of the multi-harness managed workstation (Issue #67), in a checkout:
//   ./mhw install | install --admin | status [--verbose] | check | scan | update [vX.Y.Z] | uninstall
// A Node file since #495 (S24 of #470), the same command as the npm `mhw` (Issue #68, ADR-0034): it runs
// bin/mhw.js, so both give the same output. It was a shell script that ran global/workstation.py, now gone.
// Line 2 is for a caller that still runs this file under /bin/sh: an earlier release's `mhw update` in an
// npm install runs `/bin/sh <the new package>/mhw install`. To sh it is a no-op and an exec of node on
// bin/mhw.js; to node it is a string and a comment. Windows keeps global/install.ps1, through bin/mhw.js.
import './bin/mhw.js';
