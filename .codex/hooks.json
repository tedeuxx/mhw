{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'python3 -B \"$(git rev-parse --show-toplevel)/workspace/startup.py\"'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
