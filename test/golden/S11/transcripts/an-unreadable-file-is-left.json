{
  "name": "an-unreadable-file-is-left",
  "runs": [
    {
      "args": [
        "--mode=install",
        "--stamp=release: v9.9.9; commit: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "--floor=<HOME>/floor.conf"
      ],
      "code": 3,
      "stdout": "REFUSE  <HOME>/.kiro/settings/permissions.yaml: unreadable (PermissionError); left untouched\n",
      "stderr": "",
      "tree": [
        ".kiro dir 755",
        ".kiro/settings dir 755",
        ".kiro/settings/permissions.yaml file 0 unreadable",
        "floor.conf file 644 1a67abee3986e3d1cf66748f55e8e1ee8b86532e25a0565ab5299e4f2d112360"
      ]
    },
    {
      "args": [
        "--mode=report",
        "--stamp=release: v9.9.9; commit: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "--floor=<HOME>/floor.conf"
      ],
      "code": 0,
      "stdout": "FLOOR   Kiro: user permissions.yaml not read (unreadable (PermissionError); left untouched)\n",
      "stderr": "",
      "tree": [
        ".kiro dir 755",
        ".kiro/settings dir 755",
        ".kiro/settings/permissions.yaml file 0 unreadable",
        "floor.conf file 644 1a67abee3986e3d1cf66748f55e8e1ee8b86532e25a0565ab5299e4f2d112360"
      ]
    }
  ]
}
