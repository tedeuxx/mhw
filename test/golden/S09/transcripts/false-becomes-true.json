{
  "name": "false-becomes-true",
  "runs": [
    {
      "args": "status",
      "code": 0,
      "stdout": "off (devtools.remote_debugging.user-enabled = false; no DevToolsActivePort); mhw install turns it on while Chrome is closed\n",
      "stderr": "",
      "tree": [
        {
          "path": ".claude.json",
          "mode": "644",
          "data": "text:{\"mcpServers\":{\"chrome-devtools\":{\"command\":\"/bin/sh\",\"args\":[\"-c\",\"exec npx chrome-devtools-mcp@1.8.0 --autoConnect\"]}}}"
        },
        {
          "path": "<PROFILE>/Local State",
          "mode": "644",
          "data": "text:{\"devtools\":{\"remote_debugging\":{\"user-enabled\":false}}}"
        }
      ]
    },
    {
      "args": [
        "--mode=check"
      ],
      "code": 1,
      "stdout": "DRIFT   <PROFILE>/Local State: devtools.remote_debugging.user-enabled false, want true (Chrome remote debugging)\n",
      "stderr": "",
      "tree": [
        {
          "path": ".claude.json",
          "mode": "644",
          "data": "text:{\"mcpServers\":{\"chrome-devtools\":{\"command\":\"/bin/sh\",\"args\":[\"-c\",\"exec npx chrome-devtools-mcp@1.8.0 --autoConnect\"]}}}"
        },
        {
          "path": "<PROFILE>/Local State",
          "mode": "644",
          "data": "text:{\"devtools\":{\"remote_debugging\":{\"user-enabled\":false}}}"
        }
      ]
    },
    {
      "args": [
        "--mode=install"
      ],
      "code": 0,
      "stdout": "CHANGED <PROFILE>/Local State: devtools.remote_debugging.user-enabled false -> true (Chrome remote debugging)\n",
      "stderr": "",
      "tree": [
        {
          "path": ".claude.json",
          "mode": "644",
          "data": "text:{\"mcpServers\":{\"chrome-devtools\":{\"command\":\"/bin/sh\",\"args\":[\"-c\",\"exec npx chrome-devtools-mcp@1.8.0 --autoConnect\"]}}}"
        },
        {
          "path": "<PROFILE>/Local State",
          "mode": "644",
          "data": "text:{\"devtools\":{\"remote_debugging\":{\"user-enabled\":true}}}"
        }
      ]
    },
    {
      "args": "status",
      "code": 0,
      "stdout": "on (devtools.remote_debugging.user-enabled = true; no DevToolsActivePort; Chrome asks to allow a connection)\n",
      "stderr": "",
      "tree": [
        {
          "path": ".claude.json",
          "mode": "644",
          "data": "text:{\"mcpServers\":{\"chrome-devtools\":{\"command\":\"/bin/sh\",\"args\":[\"-c\",\"exec npx chrome-devtools-mcp@1.8.0 --autoConnect\"]}}}"
        },
        {
          "path": "<PROFILE>/Local State",
          "mode": "644",
          "data": "text:{\"devtools\":{\"remote_debugging\":{\"user-enabled\":true}}}"
        }
      ]
    }
  ]
}
