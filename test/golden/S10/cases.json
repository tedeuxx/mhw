      {"write": "{HOME}/.local/share/personal-multi-harness-workstation-configuration/model-defaults.json", "text": "{\"managed-by\": 5, \"set\": {}}"},
      {"run": "check"},
      {"write": "{HOME}/.local/share/personal-multi-harness-workstation-configuration/model-defaults.json", "text": "{\"managed-by\": \"managed-by: personal-multi-harness-workstation-configuration\", \"set\": []}"},
      {"run": "check"},
