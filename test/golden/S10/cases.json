      {"chmod": "{HOME}/.codex/config.toml.pmhwc-models-backup", "mode": "644"},
      {"run": "install"}]},
    {"name": "foreign-record-refused", "steps": [
      {"write": "{HOME}/.local/share/personal-multi-harness-workstation-configuration/model-defaults.json", "text": "{\"set\": {}}"},
