{
  "comment": "The cases of the deleted global/models/model_defaults_test.py (#481, S10 of #470), as step sequences, plus byte-for-byte install -> uninstall per harness, the Codex TOML editor on a commented fixture, argument and policy errors, and the edges of Python's text semantics. Every value is synthetic. Placeholders: {BASE} the case's directory, {HOME} {BASE}/home, {POLICY} {BASE}/policy.json (the default policy is written there before the first step). Steps: write (text), bytes (hex), mkdir, chmod (octal), replace (text from -> to in a file), remove, policy (rewrite {POLICY}), run. A run passes --mode, --stamp (default STAMP), --policy (default {POLICY}) and --home={HOME} unless home is false; args replaces the whole argument list; env adds variables (CODEX_HOME and XDG_DATA_HOME are otherwise unset). After each run the transcript records the exit code, stdout, stderr and every entry under {BASE}. posix: the case needs POSIX file modes and a non-root user.",
  "stamp": "release: v9.9.9; commit: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "policy": {"version": 1, "claude-code": {"model": "claude-opus-5-5[1m]", "effort": "medium"}, "codex": {"model": "gpt-5.6-sol", "effort": "medium"}, "kiro-cli": {"model": "claude-sonnet-4.5"}},
  "cases": [
    {"name": "fresh-install-check-install-check", "steps": [{"run": "check"}, {"run": "install"}, {"run": "check"}]},
    {"name": "backup-that-cannot-be-made", "steps": [
      {"write": "{HOME}/.claude/settings.json", "text": "{\"model\": \"owner-model\"}"},
      {"write": "{HOME}/.claude/settings.json.pmhwc-models-backup/keep", "text": "x"},
      {"run": "install"}]},
    {"name": "keeps-every-other-key-and-table", "steps": [
      {"write": "{HOME}/.claude/settings.json", "text": "{\"theme\": \"dark\", \"permissions\": {\"deny\": [\"x\"]}}"},
      {"write": "{HOME}/.codex/config.toml", "text": "# mine\napproval_policy = \"on-request\"\n\n[profiles.x]\nmodel = \"other\"\n"},
      {"write": "{HOME}/.kiro/settings/cli.json", "text": "{\"chat.enableThinking\": true}"},
      {"run": "install"}]},
    {"name": "codex-commented-fixture-install-uninstall", "steps": [
      {"write": "{HOME}/.codex/config.toml", "text": "# Codex user configuration, the owner's own notes.\n# Two comment lines before anything.\n\napproval_policy = \"on-request\"   # trailing comment\nmodel = \"gpt-owner\" # the owner's model, inline comment kept\n\n# A section comment\nsandbox_mode = 'workspace-write'\n\n[profiles.fast]\n# a comment inside a table\nmodel = \"other\"\nmodel_reasoning_effort = \"low\"\n\n[mcp_servers.keep-me]\ncommand = \"x\"\nargs = [\"a\", \"b\"]\n# last line comment, no blank after\n"},
      {"run": "dry-run"}, {"run": "check"}, {"run": "install"}, {"run": "check"}, {"run": "install"}, {"run": "uninstall"}]},
    {"name": "codex-quoted-owner-keys-and-literal-values", "steps": [
      {"write": "{HOME}/.codex/config.toml", "text": "  \"model\"   =   'gpt-literal'   # spaced, literal\n'model_reasoning_effort'=\"high\"#tight\n[x]\n"},
      {"run": "install"}, {"run": "uninstall"}]},
    {"name": "codex-no-trailing-newline-and-blank-tail", "steps": [
      {"write": "{HOME}/.codex/config.toml", "text": "# no newline at the end\nmodel = \"gpt-owner\""},
      {"run": "install"}, {"run": "uninstall"},
      {"write": "{HOME}/.codex/config.toml", "text": "model = \"gpt-owner\"\n\n\n"},
      {"remove": "{HOME}/.local/share/personal-multi-harness-workstation-configuration/model-defaults.json"},
      {"run": "install"}, {"run": "uninstall"}]},
    {"name": "codex-crlf-file", "steps": [
      {"write": "{HOME}/.codex/config.toml", "text": "# crlf\r\nmodel = \"gpt-owner\"\r\n\r\n[t]\r\nk = \"v\"\r\n"},
      {"run": "install"}, {"run": "uninstall"}]},
    {"name": "codex-python-line-breaks-and-whitespace", "steps": [
      {"write": "{HOME}/.codex/config.toml", "text": "# a form feed\f in a comment\n model = \"gpt-owner\"\n# a line separator   here\n"},
      {"run": "install"}]},
    {"name": "codex-bom-first-line", "steps": [
      {"write": "{HOME}/.codex/config.toml", "text": "﻿model = \"gpt-owner\"\n"},
      {"run": "install"}]},
    {"name": "codex-unicode-owner-value-restored", "steps": [
      {"write": "{HOME}/.codex/config.toml", "text": "model = \"gpt-ç-ünï\"\n"},
