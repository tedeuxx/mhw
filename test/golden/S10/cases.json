      {"run": "install"}, {"run": "uninstall"}]},
    {"name": "kiro-json-byte-for-byte-install-uninstall", "steps": [
      {"write": "{HOME}/.kiro/settings/cli.json", "text": "{\n  \"chat.defaultModel\": \"owner-kiro\",\n  \"chat.enableThinking\": true\n}\n"},
      {"run": "install"}, {"run": "uninstall"}]},
    {"name": "json-null-value-is-absent", "steps": [
      {"write": "{HOME}/.claude/settings.json", "text": "{\"model\": null}"},
      {"run": "install"}, {"run": "uninstall"}]},
    {"name": "json-non-string-value-is-refused", "steps": [
