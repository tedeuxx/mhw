      {"run": "install"}, {"run": "uninstall"}]},
    {"name": "codex-value-forms-mhw-cannot-read", "steps": [
      {"write": "{HOME}/.codex/config.toml", "text": "model = \"\"\"triple\"\"\"\nmodel_reasoning_effort = \"a\\\"b\"\n"},
      {"run": "install"},
      {"write": "{HOME}/.codex/config.toml", "text": "model = \"x\" trailing\nmodel_reasoning_effort = 5\n"},
      {"run": "check"}]},
    {"name": "claude-json-byte-for-byte-install-uninstall", "steps": [
