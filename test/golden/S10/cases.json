      {"run": "check", "env": {"XDG_DATA_HOME": "{BASE}/xdg"}}]},
    {"name": "record-without-a-stamp-and-odd-entries", "steps": [
      {"run": "install"},
      {"write": "{HOME}/.local/share/personal-multi-harness-workstation-configuration/model-defaults.json", "text": "{\"managed-by\": \"managed-by: personal-multi-harness-workstation-configuration; no stamp here\", \"set\": {\"{HOME}/.claude/settings.json\": {\"harness\": \"claude-code\", \"keys\": {\"model\": \"claude-opus-5-5[1m]\", \"effortLevel\": \"medium\", \"n\": 5}, \"replaced\": {\"model\": 7, \"other\": \"x\"}}, \"{HOME}/.codex/config.toml\": {\"harness\": \"codex\", \"keys\": {\"model\": \"gpt-5.6-sol\", \"model_reasoning_effort\": \"medium\"}}, \"{HOME}/.kiro/settings/cli.json\": {\"harness\": \"kiro-cli\", \"keys\": {\"chat.defaultModel\": \"claude-sonnet-4.5\"}}, \"{HOME}/elsewhere.json\": {\"harness\": \"gemini\", \"keys\": {\"a\": \"b\"}}, \"{HOME}/none.json\": {\"harness\": \"claude-code\", \"keys\": {}}}}"},
      {"run": "check"}, {"run": "install"}, {"run": "check"}]},
    {"name": "unreadable-owner-value-is-a-refusal", "steps": [
