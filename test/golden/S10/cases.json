      {"write": "{HOME}/.kiro/settings/cli.json", "text": "{ not json"},
      {"run": "install"}]},
    {"name": "json-whitespace-only-is-empty", "steps": [
      {"write": "{HOME}/.claude/settings.json", "text": "  \n\t\n"},
      {"run": "install"}]},
    {"name": "native-file-invalid-utf8", "steps": [
      {"bytes": "{HOME}/.claude/settings.json", "hex": "7b226d6f64656c223a2022ff227d"},
      {"run": "install"}]},
    {"name": "native-file-is-a-directory", "steps": [
      {"mkdir": "{HOME}/.claude/settings.json"},
      {"run": "install"}]},
    {"name": "kiro-parent-is-a-file", "posix": true, "steps": [
      {"write": "{HOME}/.kiro", "text": "a file"},
      {"run": "install"}]},
    {"name": "native-file-unreadable", "posix": true, "steps": [
      {"write": "{HOME}/.codex/config.toml", "text": "model = \"x\"\n"},
      {"chmod": "{HOME}/.codex/config.toml", "mode": "000"},
      {"run": "install"},
      {"chmod": "{HOME}/.codex/config.toml", "mode": "600"}]},
    {"name": "dry-run-writes-nothing", "steps": [{"run": "dry-run"}]},
    {"name": "drift-each-harness-overwritten-old-to-new-then-restored", "steps": [
      {"run": "install"},
      {"write": "{HOME}/.claude/settings.json", "text": "{\"model\": \"opus[1m]\", \"effortLevel\": \"medium\"}"},
      {"run": "check"}, {"run": "install"}, {"run": "check"},
      {"replace": "{HOME}/.codex/config.toml", "from": "model_reasoning_effort = \"medium\"", "to": "model_reasoning_effort = \"high\""},
      {"run": "check"}, {"run": "install"}, {"run": "check"},
      {"write": "{HOME}/.kiro/settings/cli.json", "text": "{\"chat.defaultModel\": \"auto\"}"},
      {"run": "check"}, {"run": "install"}, {"run": "check"},
      {"run": "uninstall"}]},
    {"name": "uninstall-restores-the-latest-owner-value", "steps": [
      {"write": "{HOME}/.codex/config.toml", "text": "model_reasoning_effort = \"owner-x\"\n"},
      {"run": "install"},
      {"replace": "{HOME}/.codex/config.toml", "from": "\"medium\"", "to": "\"owner-z\""},
      {"run": "install"}, {"run": "uninstall"}]},
    {"name": "a-key-the-owner-deleted-is-removed-on-uninstall", "steps": [
      {"write": "{HOME}/.codex/config.toml", "text": "model_reasoning_effort = \"owner-x\"\n"},
      {"run": "install"},
      {"replace": "{HOME}/.codex/config.toml", "from": "model_reasoning_effort = \"medium\"\n", "to": ""},
      {"run": "install"}, {"run": "uninstall"}]},
    {"name": "owner-value-replaced-and-restored-byte-for-byte", "steps": [
