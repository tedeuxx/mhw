      {"policy": {"version": 1, "claude-code": {"model": "claude-opus-5-5[1m]", "effort": "medium"}, "codex": {"model": "gpt-5.7", "effort": "medium"}, "kiro-cli": {"model": "claude-sonnet-4.5"}}},
      {"run": "install"},
      {"replace": "{HOME}/.codex/config.toml", "from": "model = \"gpt", "to": "'model' = \"gpt"},
      {"policy": {"version": 1, "claude-code": {"model": "claude-opus-5-5[1m]", "effort": "medium"}, "codex": {"model": "gpt-5.8", "effort": "medium"}, "kiro-cli": {"model": "claude-sonnet-4.5"}}},
