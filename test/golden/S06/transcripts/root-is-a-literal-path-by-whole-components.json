{
  "name": "root-is-a-literal-path-by-whole-components",
  "runs": [
    {
      "args": [
        "docs/*",
        "FUNNEL-REVIEW-RAN"
      ],
      "code": 0,
      "stdout": "docs/*: never landed a file carrying FUNNEL-REVIEW-RAN\n",
