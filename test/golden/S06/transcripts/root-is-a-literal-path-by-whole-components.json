      "args": [
        "docs/*"
      ],
      "code": 0,
      "stdout": "docs/*: never changed\n",
      "stderr": ""
    },
    {
      "args": [
        "docs/funnel",
        "FUNNEL-REVIEW-RAN"
      ],
      "code": 0,
      "stdout": "docs/funnel: never landed a file carrying FUNNEL-REVIEW-RAN\n",
      "stderr": ""
    },
    {
      "args": [
        "docs/funnel"
      ],
      "code": 0,
      "stdout": "docs/funnel: never changed\n",
      "stderr": ""
    },
    {
      "args": [
        "docs/funnel-review/",
        "FUNNEL-REVIEW-RAN"
      ],
      "code": 0,
      "stdout": "docs/funnel-review/: last ran 2026-03-03 (<c1 add sprint-02.md | 2026-03-03>), dated by files carrying FUNNEL-REVIEW-RAN\n",
      "stderr": ""
    },
    {
      "args": [
        "./docs//funnel-review",
